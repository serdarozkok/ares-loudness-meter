{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARES Loudness Meter",
  "version": "1.0.0",
  "identifier": "com.aresaudio.loudnessmeter",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "inspector",
        "title": "ARES Loudness Meter",
        "url": "index.html",
        "width": 384,
        "height": 800,
        "minWidth": 340,
        "minHeight": 420,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "maximizable": false,
        "visible": true,
        "focus": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app"],
    "category": "Music",
    "shortDescription": "Real-time loudness & phase meter",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
